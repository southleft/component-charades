# TypeSafe API key. Get one at https://console.typesafe.ai
# Copy this file to .env.local and fill it in. The key is only ever read server-side.
TYPESAFE_API_KEY=

# Optional. Defaults to jev-latest. Pin a version (e.g. jev-1.13.0) once you tune thresholds.
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional. Set to "fixtures" to run the UI against canned responses with no API spend.
# JEV_MODE=fixtures
